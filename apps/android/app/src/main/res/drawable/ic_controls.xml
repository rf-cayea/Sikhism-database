<!-- Lucide `settings-2`, lucide-static 1.55.0, ISC — the same SVG as
     apps/ios/ShabadOS/Assets.xcassets/settings-2.imageset, translated by hand
     into a vector drawable. Android has no SVG <circle>, so each circle is two
     arcs; everything else is the upstream geometry and stroke unchanged. The
     colour is irrelevant: Compose's Icon tints the shape with LocalContentColor.
     See packages/design/icons.md, "Lucide assets". -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <!-- <path d="M14 17H5" /> -->
  <path
      android:pathData="M14,17H5"
      android:strokeColor="@android:color/white"
      android:strokeWidth="2"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"/>
  <!-- <path d="M19 7h-9" /> -->
  <path
      android:pathData="M19,7h-9"
      android:strokeColor="@android:color/white"
      android:strokeWidth="2"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"/>
  <!-- <circle cx="17" cy="17" r="3" /> -->
  <path
      android:pathData="M14,17a3,3 0,1 0,6 0a3,3 0,1 0,-6 0"
      android:strokeColor="@android:color/white"
      android:strokeWidth="2"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"/>
  <!-- <circle cx="7" cy="7" r="3" /> -->
  <path
      android:pathData="M4,7a3,3 0,1 0,6 0a3,3 0,1 0,-6 0"
      android:strokeColor="@android:color/white"
